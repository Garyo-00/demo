{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>arch-dx/config//packages/renovate/default"],
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "groupName": "node and mise tool versions",
      "matchManagers": ["mise", "npm"],
      "matchDepNames": ["node", "pnpm", "npm:pnpm"]
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["vite", "/^@vitejs//", "/^vite-/"]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "react-router",
      "matchPackageNames": ["react-router", "react-router-dom"]
    },
    {
      "groupName": "mui",
      "matchPackageNames": ["/^@mui\\//", "/^@emotion\\//"]
    }
  ]
}
